#!/usr/bin/env bash
# Unified network monitor TUI — run from anywhere
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/.venv"

if [ ! -d "$VENV" ]; then
    echo "Running setup first..."
    bash "$SCRIPT_DIR/install.sh"
fi

source "$VENV/bin/activate"
cd "$SCRIPT_DIR"
exec python -m netmon "$@"
